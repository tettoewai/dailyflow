{
  "expo": {
    "name": "DailyFlow",
    "slug": "DailyFlow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailyflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tettoewai.DailyFlow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tettoewai.DailyFlow"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/splash/icon.png",
          "imageWidth": 76
        }
      ],
      ["@react-native-vector-icons/ionicons", { "fontName": "Ionicons" }],
      ["@react-native-vector-icons/lucide", { "fontName": "Lucide" }],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
